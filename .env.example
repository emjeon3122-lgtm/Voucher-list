# ============================================================
#  상품권 수불 관리 시스템 설정 (.env.example → .env 로 복사 후 수정)
# ============================================================

# ---- 기본 ----
APP_NAME=상품권 수불 관리
COMPANY_NAME=
# 세션 암호화 키: 반드시 길고 무작위한 값으로 변경
#   생성 예) python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# 직원이 메일 속 서명 링크로 접속할 주소 (NAS 주소 + 포트 또는 리버스프록시 도메인)
BASE_URL=http://192.168.0.10:8000
TIMEZONE=Asia/Seoul

# ---- 로그인 ----
# 로그인 허용 메일 도메인 (여러 개는 쉼표로 구분, 비우면 제한 없음)
ALLOWED_EMAIL_DOMAINS=company.co.kr
# 최초 관리자 (이메일:성명, 여러 명은 쉼표로 구분). 최초 실행 시 자동 등록
ADMIN_EMAILS=admin@company.co.kr:홍길동
LOGIN_CODE_MINUTES=10
SESSION_HOURS=12
# HTTPS(리버스 프록시)로 운영하면 1 로 변경
SESSION_COOKIE_SECURE=0
# 리버스 프록시(시놀로지 역방향 프록시 등) 뒤에서 운영하면 1 (서명자 실제 IP 기록)
TRUST_PROXY=0
# 테스트용: 인증코드를 로그인 화면에 표시 (운영에서는 반드시 0)
DEV_SHOW_CODES=0

# ---- 전자서명 ----
SIGN_LINK_DAYS=7
# 1 이면 서명 링크를 연 직원도 회사메일 인증 로그인 후에만 서명 가능 (본인확인 강화)
SIGN_REQUIRE_LOGIN=0

# ---- 메일 (SMTP) ----
# SMTP_HOST 를 비워두면 메일을 보내지 않고 'docker logs' 에 내용만 출력합니다 (초기 테스트용).
#
# [Microsoft 365 / Outlook.com]
#   SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_STARTTLS=1
#   SMTP_USER=발송계정@company.co.kr  SMTP_PASSWORD=비밀번호(MFA 사용 시 앱 비밀번호)
#   ※ M365 관리센터에서 해당 사서함의 'SMTP AUTH(인증된 SMTP)' 를 허용해야 합니다.
# [사내 Exchange 릴레이(인증 없음)]
#   SMTP_HOST=mail.company.local  SMTP_PORT=25  SMTP_STARTTLS=0  SMTP_USER=  SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
SMTP_SSL=0
# 사내 메일서버가 자체서명 인증서를 쓰는 경우에만 0
SMTP_TLS_VERIFY=1
MAIL_FROM_NAME=상품권 수불관리
