# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 에는 비밀값이 들어가므로 메일·메신저·저장소에 올리지 않는다.
# (값 대신 파일 경로를 쓰려면 변수 이름 뒤에 _FILE 을 붙인다. 예: OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc)

# ---- 실행 계정 ----
# ./data 폴더를 소유한 NAS 전용 계정의 UID/GID (SSH 에서 `id 계정명` 으로 확인)
APP_UID=
APP_GID=

# ---- 주소·포트 ----
# 직원이 접속하는 주소(DSM 역방향 프록시 https). 서명 메일 링크와 Entra 리디렉션 URI(= 이 주소 + /auth/callback)에 쓰인다.
PUBLIC_URL=https://192.168.100.25:7031
# 앱이 여는 포트(http). 역방향 프록시가 여기로 넘겨준다. host 네트워크이므로 127.0.0.1 로만 연다.
# (NAS 에서 이미 쓰는 포트와 겹치지 않게. 실적 대시보드는 7020/7021 사용 중)
PORT=7030
HOST=127.0.0.1
# 역방향 프록시가 붙여 주는 X-Forwarded-For 로 접속자(서명자) IP 를 기록한다
TRUST_PROXY=true
# HTTPS(역방향 프록시) 뒤에서 쓰므로 true 유지
COOKIE_SECURE=true

# ---- 세션 ----
# 세션 암호화 키: 32자 이상 임의 문자열 (예: openssl rand -base64 48). 바꾸면 모든 사용자가 다시 로그인한다.
SESSION_SECRET=
SESSION_HOURS=8

# ---- 관리자 ----
# 관리자 = 이 시스템에 접속하는 사람(이메일:성명, 쉼표로 여러 명). 이 목록이 기준이며 빠진 사람은 관리자에서 해제된다.
# 직원(수령자)은 로그인하지 않고 메일 링크로 서명만 한다. 수령자는 회사 주소록에서 찾으므로 명단 관리가 없다.
ADMIN_EMAILS=

# ---- 관리자 로그인 방식 ----
# oidc : 회사 Microsoft 365 계정 로그인(Microsoft Entra ID) — 운영
# email: 회사 메일로 받은 6자리 인증코드 로그인 — Entra 앱 등록 전 임시용
AUTH_MODE=oidc
# 로그인을 허용할 이메일 도메인(쉼표로 여러 개)
ALLOWED_EMAIL_DOMAINS=bdo.kr

# ---- Microsoft Entra ID (AUTH_MODE=oidc) ----
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# (선택) 이 Entra 앱 역할을 받은 사람도 관리자로 인정
OIDC_ADMIN_ROLE=Admin
# (선택) 발급자 주소를 직접 지정할 때만. 비우면 OIDC_TENANT_ID 로 자동 구성
# OIDC_ISSUER=

# ---- 전자서명 ----
SIGN_LINK_DAYS=7

# ---- 회사 주소록 (수령자 찾기) ----
# graph: Microsoft 365 주소록 — Entra 앱에 User.Read.All(애플리케이션) 권한 + 관리자 동의 필요
DIRECTORY_BACKEND=graph

# ---- 메일 (서명 요청 메일 발송) ----
# graph  : Microsoft Graph 로 발송(권장). 위 Entra 앱에 Mail.Send(애플리케이션) 권한 + 관리자 동의 필요
# smtp   : SMTP 로 발송(사내 메일 릴레이 등)
# console: 보내지 않고 컨테이너 로그에만 출력(설치 직후 시험용)
MAIL_BACKEND=console
# 보내는 사서함(공용 사서함 권장). graph 는 이 사서함 이름으로 발송한다
MAIL_SENDER=
MAIL_FROM_NAME=상품권 수불관리
# (선택) 메일 발송을 로그인과 다른 Entra 앱으로 할 때만. 비우면 OIDC_* 값을 그대로 쓴다
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# smtp 일 때만
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TLS_VERIFY=true

# ---- 자동 백업 ----
# 매일 이 시각(시) 이후 하루 한 번 DB 사본을 만든다. 폴더를 비우면 /data/backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=30
# BACKUP_DIR=/data/backups
